# Copy this file to .env and adjust values as needed.
AWG_MODE=simulator

# Leave DATABASE_URL unset in simulator mode to use the local SQLite database.
# Set it only when a PostgreSQL server is running and reachable.
# DATABASE_URL=postgresql://postgres:postgres@localhost:55432/businessintelligence

# API server. If AWG_API_PORT is busy, the app tries the next free port.
AWG_API_HOST=127.0.0.1
AWG_API_PORT=5000

# Hardware mode options
# AWG_MODE=hardware
# AWG_SENSOR_SOURCE=file
# AWG_SENSOR_FILE=awg_data/hardware_sensors.json
# For HTTP input, use these instead of AWG_SENSOR_SOURCE=file:
# AWG_SENSOR_SOURCE=http
# AWG_SENSOR_HTTP_URL=http://127.0.0.1:8090/latest
# AWG_RELAY_BACKEND=none
# AWG_RELAY_ACTIVE_LOW=1
# AWG_RELAY_AWG_GPIO=17
# AWG_RELAY_PUMP_GPIO=27
# AWG_RELAY_VALVE_GPIO=22
